                   $description="Dirty Frag (xfrm-ESP): page-cache write -> local root")
        ),
        ["rocky|8|kernel"] = vector(
            CVERec($cve="CVE-2026-31431", $fixed_in="4.18.0-553.123.1.el8_10",
                   $severity="High",
                   $description="Copy Fail: algif_aead page-cache write -> local root (public PoC)")
            # CVE-2026-43500 NOT APPLICABLE: Rocky 8 does not ship rxrpc.ko
        ),
        ["rocky|9|kernel"] = vector(
            CVERec($cve="CVE-2026-31431", $fixed_in="5.14.0-611.54.1.el9_7",
                   $severity="High",
                   $description="Copy Fail: algif_aead page-cache write -> local root (public PoC)")
        ),
        ["rocky|10|kernel"] = vector(
            CVERec($cve="CVE-2026-31431", $fixed_in="6.12.0-124.52.1.el10_1",
                   $severity="High",
                   $description="Copy Fail: algif_aead page-cache write -> local root (public PoC)")
        ),
        ["amazon|2023|kernel"] = vector(
            CVERec($cve="CVE-2026-31431", $fixed_in="6.1.168-203.330.amzn2023",
                   $severity="High",
                   $description="Copy Fail: algif_aead page-cache write -> local root (public PoC)"),
            CVERec($cve="CVE-2026-43284", $fixed_in="6.1.170-210.320.amzn2023",
                   $severity="High",
                   $description="Dirty Frag (xfrm-ESP): page-cache write -> local root")
        ),
    } &redef &default = vector();

    ## Codename -> release number, so "ubuntu|jammy|x" and "ubuntu|22.04|x"
    ## table rows (and os_info versions like "bookworm") all land on the
    ## same key. Applied to both package_cves keys and observed versions.
    const release_numbers: table[string] of string = {
        ["debian|jessie"]   = "8",
        ["debian|stretch"]  = "9",
        ["debian|buster"]   = "10",
        ["debian|bullseye"] = "11",
        ["debian|bookworm"] = "12",
        ["debian|trixie"]   = "13",
        ["debian|forky"]    = "14",
        ["ubuntu|precise"]  = "12.04",
        ["ubuntu|trusty"]   = "14.04",
        ["ubuntu|xenial"]   = "16.04",
        ["ubuntu|bionic"]   = "18.04",
        ["ubuntu|focal"]    = "20.04",
        ["ubuntu|jammy"]    = "22.04",
        ["ubuntu|noble"]    = "24.04",
        ["ubuntu|oracular"] = "24.10",
        ["ubuntu|plucky"]   = "25.04",
        ["ubuntu|questing"] = "25.10",
        ["ubuntu|resolute"] = "26.04",
    } &redef;

    global compare_pkg_versions: function(a: string, b: string): int;
    global lookup_key:           function(distro: string, distro_major: string, package: string): string;
    global upstream_part:        function(v: string): string;
    global distro_part:          function(v: string): string;
    global normalize_version:    function(v: string): string;
}

global reported: set[addr, string, string]
    &create_expire=dedup_interval;

## "ubuntu|22.04" -> "jammy": package_cves rows may be keyed either way,
## so lookups try both spellings. (Tables are looked up IN PLACE - never
## copied - because site feeds can redef package_cves with millions of
## rows.)
global release_codename: table[string] of string;

## Every package name that appears in package_cves. Lets the hook skip the
## vast majority of package downloads with a single set lookup.
global known_packages: set[string];

## classify() result per (os, os_version). There are only a few dozen
## distinct values, so this turns ~20 regex tests per package into one
## table lookup.
global classify_cache: table[string, string] of string_vec &read_expire=1day;

const rhel_family: set[string] = {
    "rhel", "centos", "centos-stream", "rocky", "almalinux", "oracle",
    "fedora", "amazon",
};

function normalize_release(distro: string, v: string): string
    {
    local k = distro + "|" + v;
    return (k in release_numbers) ? release_numbers[k] : v;
    }

## OSV binary -> source aliases (normalised keys) and the set of binary
## names, for the hook's cheap early rejection.
global osv_alias: table[string] of string;
global alias_binaries: set[string];

## "debian|bookworm|x" -> "debian|12|x". Returns "" for malformed keys.
function normalize_key(key: string): string
    {
    local f = split_string(key, /\|/);
    if ( |f| != 3 )
        return "";
    return fmt("%s|%s|%s", f[0], normalize_release(f[0], f[1]), f[2]);
    }

## Builtin (package_cves) rows for distro|release|pkg, trying the numeric
## and codename spellings of the release.
function builtin_cves(distro: string, rel: string, pkg: string): vector of CVERec
    {
    local k1 = fmt("%s|%s|%s", distro, rel, pkg);
    local dr = distro + "|" + rel;
    local k2 = (dr in release_codename) ? fmt("%s|%s|%s", distro, release_codename[dr], pkg) : "";
    local in1 = k1 in package_cves;
    local in2 = k2 != "" && k2 in package_cves;
    if ( in1 && ! in2 )
        return package_cves[k1];
    if ( in2 && ! in1 )
        return package_cves[k2];
    if ( ! in1 )
        return vector();

    # Both spellings present (rare): merge, dropping duplicate CVE ids.
    local out: vector of CVERec = vector();
    local have: set[string] = set();
    for ( _, c in package_cves[k1] )
        {
        out += c;
        add have[c$cve];
        }
    for ( _, c in package_cves[k2] )
        if ( c$cve !in have )
            out += c;
    return out;
    }

event zeek_init() &priority=5
    {
    Log::create_stream(PkgCVE::LOG, [$columns=Info, $path="package_cve"]);

    for ( dr, num in release_numbers )
        {
        local d = split_string(dr, /\|/);
        if ( |d| == 2 )
            release_codename[d[0] + "|" + num] = d[1];
        }

    # Only the package NAMES are collected (a few tens of thousands of
    # short strings even with a million-row feed loaded).
    for ( key in package_cves )
        {
        local f = split_string(key, /\|/);
        if ( |f| == 3 )
            add known_packages[f[2]];
        }
    for ( key in osv_package_cves )
        {
        local g = split_string(key, /\|/);
        if ( |g| == 3 )
            add known_packages[g[2]];
        }

    for ( key, src in osv_binary_sources )
        {
        local nk = normalize_key(key);
        if ( nk == "" )
            next;
        osv_alias[nk] = src;
        add alias_binaries[split_string(nk, /\|/)[2]];
        }

    if ( |osv_package_cves| > 0 )
        Reporter::info(fmt("PkgCVE: OSV data generated %s: %d packages, %d binary aliases",
                           osv_generated_at, |osv_package_cves|, |osv_alias|));
    }

## Strip the distro suffix from a version (everything after the first '-'
## that isn't part of an upstream pre-release marker). Returns the
## upstream-only version. E.g.:
##   "1.1.1f-1ubuntu2.19"  -> "1.1.1f"
##   "1.1.1k-9.el8_8"      -> "1.1.1k"
##   "8.4p1-6ubuntu2.4"    -> "8.4p1"
function upstream_part(v: string): string
    {
    local idx = strstr(v, "-");
    if ( idx == 0 )
        return v;
    return sub_bytes(v, 1, idx - 1);
    }

## Distro suffix part (after first '-'). Returns "" if none.
function distro_part(v: string): string
    {
    local idx = strstr(v, "-");
    if ( idx == 0 )
        return "";
    return sub_bytes(v, idx + 1, -1);
    }

## Split a version segment into a vector of (numeric_run, alpha_run)
## tokens for natural-sort comparison. "1.1.1f" -> ["1","1","1","f"]
## "9.el8_8" -> ["9","el","8","8"]. Punctuation ('.', '_', '+', '~',
## '-') is treated as a separator and dropped, so "481.1.el9_6" gives
## ["481","1","el","9","6"] which compares correctly against "481.el9"
## (z-stream micro-rebuild: position 1 has "1" vs "el", numeric wins).
function tokenize_version(v: string): string_vec
    {
    local toks: string_vec = vector();
    local cur = "";
    local in_digit = F;
    local i = 1;
    while ( i <= |v| )
        {
        local ch = sub_bytes(v, i, 1);
        if ( /^[._+~-]$/ in ch )
            {
            if ( cur != "" )
                {
                toks += cur;
                cur = "";
                }
            i += 1;
            next;
            }
        local is_digit = (/^[0-9]$/ in ch);
        if ( cur == "" )
            {
            cur = ch;
            in_digit = is_digit;
            }
        else if ( is_digit == in_digit )
            cur += ch;
        else
            {
            toks += cur;
            cur = ch;
            in_digit = is_digit;
            }
        i += 1;
        }
    if ( cur != "" )
        toks += cur;
    return toks;
    }

## Compare two version strings using natural sort: numeric runs are
## compared as integers, alphabetic runs lexically. Best-effort - does
## NOT fully implement dpkg's tilde/epoch rules. Returns -1/0/+1.
## Normalise a package version string by:
##   - stripping leading "N:" RPM/dpkg epoch
##   - stripping trailing ".noarch" / ".x86_64" / ".aarch64" / ".i686" arch
## This lets us compare versions that come from different sources
## (filename-parsed observed vs OSV-emitted fixed_in) without false hits.
function normalize_version(v: string): string
    {
    local out = v;
    if ( /^[0-9]+:/ in out )
        {
        local colon_pos = strstr(out, ":");
        if ( colon_pos > 0 )
            out = sub_bytes(out, colon_pos + 1, -1);
        }
    # find_last returns the matched substring (e.g. ".x86_64");
    # truncate everything from that match's position onward.
    local arch_match = find_last(out,
        /\.(noarch|x86_64|aarch64|i686|armv7hl|s390x|ppc64le)$/);
    if ( arch_match != "" )
        out = sub_bytes(out, 1, |out| - |arch_match|);
    return out;
    }

function compare_pkg_versions(a: string, b: string): int
    {
    a = normalize_version(a);
    b = normalize_version(b);
    if ( a == b )
        return 0;

    local a_up = upstream_part(a);
    local b_up = upstream_part(b);

    local ta = tokenize_version(a_up);
    local tb = tokenize_version(b_up);
    local n = (|ta| > |tb|) ? |ta| : |tb|;
    local i = 0;
    while ( i < n )
        {
        # A version that has run out of tokens sorts BEFORE one that
        # continues with an alpha token (dpkg: "2.0.2" < "2.0.2ubuntu0.1").
        # Against a numeric token it is padded with "0" ("1.6" == "1.6.0").
        if ( i >= |ta| && /^[0-9]+$/ !in tb[i] )
            return -1;
        if ( i >= |tb| && /^[0-9]+$/ !in ta[i] )
            return 1;
        local sa = (i < |ta|) ? ta[i] : "0";
        local sb = (i < |tb|) ? tb[i] : "0";
        local sa_num = (/^[0-9]+$/ in sa);
        local sb_num = (/^[0-9]+$/ in sb);
        if ( sa_num && sb_num )
            {
            local ia = to_count(sa);
            local ib = to_count(sb);
            if ( ia < ib ) return -1;
            if ( ia > ib ) return  1;
            }
        else if ( sa_num && ! sb_num )
            return 1;
        else if ( ! sa_num && sb_num )
            return -1;
        else
            {
            if ( sa < sb ) return -1;
            if ( sa > sb ) return  1;
            }
        i += 1;
        }

    # Upstream parts equal. Compare distro suffixes (so "1.1.1k-9.el8_8"
    # > "1.1.1k-1.el8" - meaning the distro patched it later).
    local ad = distro_part(a);
    local bd = distro_part(b);
    if ( ad == bd )
        return 0;
    # An absent distro suffix means upstream-pristine, which sorts BEFORE
    # any patched build. Fixes "0.105-31" < "0.105-31+deb11u1" semantics.
    if ( ad == "" )
        return -1;
    if ( bd == "" )
        return  1;
    local tad = tokenize_version(ad);
    local tbd = tokenize_version(bd);
    local shared = (|tad| < |tbd|) ? |tad| : |tbd|;
    local j = 0;
    while ( j < shared )
        {
        local sca = tad[j];
        local scb = tbd[j];
        local sca_num = (/^[0-9]+$/ in sca);
        local scb_num = (/^[0-9]+$/ in scb);
        if ( sca_num && scb_num )
            {
            local ica = to_count(sca);
            local icb = to_count(scb);
            if ( ica < icb ) return -1;
            if ( ica > icb ) return  1;
            }
        else if ( sca_num && ! scb_num )
            # Numeric beats alpha at the same position. Handles z-stream
            # micro-rebuilds: "481.1.el9_6" sorts AFTER "481.el9" because
            # the second token is "1" (numeric) vs ".el" (alpha).
            return 1;
        else if ( ! sca_num && scb_num )
            return -1;
        else
            {
            if ( sca < scb ) return -1;
            if ( sca > scb ) return  1;
            }
        j += 1;
        }
    # Shared prefix matched. The vector with MORE tokens has additional
    # build/patch info appended (e.g. "31" vs "31+deb11u1") so it sorts
    # AFTER the shorter one - matching Debian's "+debNuN" rebuild
    # semantics.
    if ( |tad| < |tbd| ) return -1;
    if ( |tad| > |tbd| ) return  1;
    return 0;
    }

function lookup_key(distro: string, distro_major: string, package: string): string
    {
    return fmt("%s|%s|%s", distro, distro_major, package);
    }

## RHEL-family RPMs split a single source package (SRPM) into many binary
## subpackages: e.g. SRPM "python-markupsafe" ships binary RPM
## "python3-markupsafe", SRPM "cairo" ships "cairo-gobject", etc. OSV /
## RHSA / ALSA / RLSA advisories index by SRPM name, but downloads we
## observe use the binary subpackage name. Without alias expansion every
## subpackage download misses the CVE table.
##
## This produces an ordered list of candidate names to try for one
## observed binary RPM name. The original name is tried first, then
## progressively-stripped variants.
##
## Heuristics intentionally conservative - extra candidates can only
## produce hits that would have been valid; they cannot create false
## positives because the version comparator still has to agree.
global rpm_subpkg_strip_prefixes: vector of string = vector(
    "python3-", "python2-", "python-",
    "perl-", "ruby-", "php-", "nodejs-",
    "lib", "lib64-",
    "ghc-", "rust-", "golang-"
);

## RHEL convention: subpackage suffixes for "the libraries shipped by
## the SRPM". Note "-lib" (singular) is intentionally absent: in CPAN
## land "perl-lib" is the unrelated "lib" CPAN module, not perl's libs.
## Same logic for "-doc" (singular) - some packages legitimately end
## in "-doc" without being subpackages.
global rpm_subpkg_strip_suffixes: vector of string = vector(
    "-devel", "-libs", "-docs",
    "-common", "-tools", "-utils", "-data",
    "-debuginfo", "-debugsource",
    "-server", "-client",
    "-core", "-extras",
    "-static", "-headers", "-runtime",
    "-javadoc", "-tests", "-examples",
    "-systemd", "-selinux"
);

function subpackage_candidates(distro: string, package: string): vector of string
    {
    local out: vector of string = vector(package);

    # Only RHEL-family suffers from the SRPM/binary split in OSV. Debian
    # and Ubuntu OSV records use binary package names directly.
    if ( distro !in rhel_family )
        return out;

    # Prefix stripping. python3-markupsafe -> markupsafe (which then maps
    # to candidate "python-markupsafe" via the next loop's seed list, but
    # we also emit the bare stripped name).
    local stripped_pref: set[string];
    local i = 0;
    while ( i < |rpm_subpkg_strip_prefixes| )
        {
        local p = rpm_subpkg_strip_prefixes[i];
        local plen = |p|;
        if ( |package| > plen && sub_bytes(package, 1, plen) == p )
            {
            local rest = sub_bytes(package, plen + 1, |package| - plen);
            if ( rest != "" && rest !in stripped_pref )
                {
                add stripped_pref[rest];
                out += rest;
                # python3-markupsafe -> python-markupsafe (very common
                # SRPM rename).
                if ( p == "python3-" || p == "python2-" )
                    out += "python-" + rest;
                }
            }
        i += 1;
        }

    # Suffix stripping. openssl-devel -> openssl, kernel-modules -> kernel.
    local seeds: vector of string = vector(package);
    for ( name in stripped_pref )
        seeds += name;

    local s = 0;
    while ( s < |seeds| )
        {
        local seed = seeds[s];
        local j = 0;
        while ( j < |rpm_subpkg_strip_suffixes| )
            {
            local sx = rpm_subpkg_strip_suffixes[j];
            local sxlen = |sx|;
            if ( |seed| > sxlen &&
                 sub_bytes(seed, |seed| - sxlen + 1, sxlen) == sx )
                {
                local base = sub_bytes(seed, 1, |seed| - sxlen);
                if ( base != "" )
                    out += base;
                }
            j += 1;
            }
        s += 1;
        }

    # Kernel binary subpackages all map to SRPM "kernel".
    if ( /^kernel-/ in package )
        out += "kernel";

    return out;
    }

## Map an OS string + version into a (distro, distro_major) pair we can
## use as a lookup key. Reuses EOLLinux helpers when available.
function classify(os_str: string, os_version: string): string_vec
    {
    if ( [os_str, os_version] in classify_cache )
        return classify_cache[os_str, os_version];

    local out: string_vec = vector("", "");
    local d = EOLLinux::normalize_distro(os_str);
    if ( d != "unknown" )
        {
        local v = os_version;
        if ( v == "" || EOLLinux::looks_like_edition(v) )
            {
            local recovered = EOLLinux::recover_version_from_os(os_str);
            if ( recovered != "" )
                v = recovered;
            }
        # For RHEL family we key on major only.
        if ( d in EOLLinux::major_only_distros && v != "" )
            {
            local parts = split_string(v, /\./);
            if ( |parts| > 0 )
                v = parts[0];
            }
        out[0] = d;
        out[1] = normalize_release(d, v);
        }

    classify_cache[os_str, os_version] = out;
    return out;
    }

const sev_rank: table[string] of count = {
    ["Negligible"] = 0, ["Low"] = 1, ["Unknown"] = 2, ["Medium"] = 2,
    ["Info"] = 1, ["High"] = 3, ["Critical"] = 4,
} &default=2;

## Kernel image/module packages carry the ABI in their name, so they never
## appear in alias tables for old ABIs. Their version is the kernel source
## version, so map them onto source "linux".
const deb_kernel_binary = /^linux-(image|image-unsigned|modules|modules-extra|headers)-[0-9]+\.[0-9]+\.[0-9]+-[0-9]+-(amd64|arm64|686|686-pae|cloud-amd64|cloud-arm64|rt-amd64|rt-arm64|generic|generic-64k|generic-lpae|lowlatency)$/;

## Number of CVE ids in a CVERec$cve list ("a,b,+3 more" -> 5).
function cve_list_count(s: string): count
    {
    local n = 0;
    for ( _, t in split_string(s, /,/) )
        {
        if ( /^\+[0-9]+ more$/ in t )
            n += to_count(sub_bytes(t, 2, strstr(t, " ") - 2));
        else if ( t != "" )
            n += 1;
        }
    return n;
    }

function emit_match(rec: OSPTracking::PackageInfo, distro: string, distro_major: string,
                    cve: string, n: count, fixed_in: string, severity: string,
                    description: string, origin: string, dedup: string)
    {
    if ( [rec$host, rec$package, dedup] in reported )
        return;
    add reported[rec$host, rec$package, dedup];

    local r = Info($ts=rec$ts, $host=rec$host,
                   $package=rec$package, $version=rec$version,
                   $distro=distro, $distro_major=distro_major,
                   $cve=cve, $cve_count=n, $fixed_in=fixed_in,
                   $severity=severity, $description=description,
                   $origin=origin);
    if ( rec?$request && rec$request?$uri )
        r$request_uri = rec$request$uri;
    Log::write(PkgCVE::LOG, r);

    if ( raise_notice )
        NOTICE([$note=Vulnerable_Package_Detected,
                $src=rec$host,
                $identifier=fmt("%s|%s|%s", rec$host, rec$package, dedup),
                $suppress_for=dedup_interval,
                $msg=fmt("%s %s on %s %s: %d unpatched CVE(s), worst %s, fixed in %s (%s)",
                         rec$package, rec$version, distro, distro_major,
                         n, severity, fixed_in,
                         n <= 3 ? cve : sub_bytes(cve, 1, 60) + "..."),
                $sub=description]);
    }

hook OSPTracking::package_log_policy(rec: OSPTracking::PackageInfo,
                                     id: Log::ID,
                                     filter: Log::Filter)
    {
    if ( ! rec?$os || ! rec?$os_version )
        return;

    local pkg = rec$package;
    local deb_family = F;

    # Cheapest rejection first: one set lookup for the ~99% of downloads
    # that aren't in any CVE table. RHEL-family names go through
    # subpackage stripping so can't be rejected this early.
    local is_kernel = /^linux-/ in pkg && deb_kernel_binary in pkg;
    if ( pkg !in known_packages && pkg !in alias_binaries && ! is_kernel &&
         /^(kernel|python|perl|ruby|php|nodejs|lib|ghc|rust|golang)/ !in pkg &&
         /-(devel|libs|docs|common|tools|utils|data|server|client|core|extras|static|headers|runtime|systemd|selinux)$/ !in pkg )
        return;

    local cls = classify(rec$os, rec$os_version);
    local distro = cls[0];
    local distro_major = cls[1];
    if ( distro == "" || distro_major == "" )
        return;

    # Candidate names: the observed binary, the exact OSV source alias,
    # the kernel source for ABI-named kernel packages, then (RHEL family)
    # heuristic SRPM names.
    local candidates: vector of string = vector(pkg);
    local akey = lookup_key(distro, distro_major, pkg);
    if ( akey in osv_alias )
        candidates += osv_alias[akey];
    if ( is_kernel && (distro == "debian" || distro == "ubuntu") )
        candidates += "linux";
    if ( distro in rhel_family )
        for ( _, sc in subpackage_candidates(distro, pkg) )
            candidates += sc;

    # If OSV data covers this package (by its own name or its source
    # alias), the hand-written / site-feed package_cves rows are skipped.
    local osv_covered = F;
    if ( osv_overrides_builtin )
        for ( _, oc in candidates )
            if ( lookup_key(distro, distro_major, oc) in osv_package_cves )
                osv_covered = T;

    local matched: vector of CVERec = vector();
    local seen_cands: set[string] = set();
    local seen_cves: set[string] = set();
    for ( _, cand in candidates )
        {
        if ( cand !in known_packages || cand in seen_cands )
            next;
        add seen_cands[cand];

        local key = lookup_key(distro, distro_major, cand);
        local rows: vector of CVERec = vector();
        if ( key in osv_package_cves )
            rows = osv_package_cves[key];
        else if ( ! osv_covered )
            rows = builtin_cves(distro, distro_major, cand);

        for ( _, c in rows )
            if ( c$cve !in seen_cves &&
                 compare_pkg_versions(rec$version, c$fixed_in) < 0 )
                {
                add seen_cves[c$cve];
                matched += c;
                }
        }

    if ( |matched| == 0 )
        return;

    if ( ! collapse_matches || |matched| == 1 )
        {
        for ( _, c in matched )
            emit_match(rec, distro, distro_major, c$cve, cve_list_count(c$cve),
                       c$fixed_in, c$severity, c$description, c$origin, c$cve);
        return;
        }

    # Collapse: one row, every unpatched CVE, the version that fixes all,
    # worst severity, description of the worst group.
    local ids: vector of string = vector();
    local total = 0;
    local worst = matched[0];
    local fix_all = matched[0]$fixed_in;
    local origins: set[string] = set();
    for ( _, c in matched )
        {
        total += cve_list_count(c$cve);
        for ( _, t in split_string(c$cve, /,/) )
            if ( /^\+/ !in t && |ids| < max_cves_in_row )
                ids += t;
        if ( sev_rank[c$severity] > sev_rank[worst$severity] )
            worst = c;
        if ( compare_pkg_versions(c$fixed_in, fix_all) > 0 )
            fix_all = c$fixed_in;
        add origins[c$origin];
        }
    local cve_str = join_string_vec(ids, ",");
    if ( total > |ids| )
        cve_str += fmt(",+%d more", total - |ids|);
    local origin = |origins| == 1 ? worst$origin : "builtin+osv";

    emit_match(rec, distro, distro_major, cve_str, total, fix_all,
               worst$severity, fmt("%d fix(es) missing; worst: %s", |matched|, worst$description),
               origin, "fix:" + fix_all);
    }
