##! detect-package-cve.zeek
##!
##! Companion to OSPTracking. Hooks into Package_Log via package_log_policy
##! and emits a row to package_cve.log when a host installs a known-
##! vulnerable version of a critical package.
##!
##! Scope (deliberate):
##!   - Allowlist of ~10 high-impact packages (openssl, openssh, sudo,
##!     polkit, glibc, bash, xz-utils, curl, nginx, apache2, bind9, kernel)
##!   - Distro-aware fixed-in versions (RHEL 8, RHEL 9, Debian, Ubuntu)
##!     because backports do NOT bump upstream version
##!
##! Known limitations:
##!   - Only flags packages we observe being DOWNLOADED. A host with an
##!     ancient never-updated package is invisible.
##!   - Distro version comparison is a best-effort approximation, not a
##!     full implementation of dpkg's or rpm's compare semantics. Tilde
##!     and epoch handling is naive. Tune by editing the table when you
##!     observe false positives.
##!   - Static binaries, language packages (pip/npm/cargo), and container
##!     image layers are out of scope.

@load base/frameworks/logging
@load base/frameworks/notice
@load ./os-package-tracking
@load ./detect-eol-linux

module PkgCVE;

export {
    redef enum Log::ID += { LOG };

    redef enum Notice::Type += {
        Vulnerable_Package_Detected,
    };

    type Info: record {
        ts:           time   &log;
        host:         addr   &log;
        package:      string &log;
        version:      string &log;
        distro:       string &log;
        distro_major: string &log;
        cve:          string &log;
        fixed_in:     string &log;
        severity:     string &log;
        description:  string &log;
        request_uri:  string &log &optional;
        ## Number of CVEs in this row (rows can carry a CVE list).
        cve_count:    count  &log &default=1;
        ## Where the match came from: "builtin" (package_cves) or "osv".
        origin:       string &log &default="builtin";
    };

    option raise_notice: bool = T;

    const dedup_interval = 1day &redef;

    type CVERec: record {
        ## A single CVE id, or a comma separated list (OSV rows group all
        ## CVEs that share a fixed version; "+N more" marks truncation).
        cve:         string;
        fixed_in:    string;
        severity:    string;
        description: string;
        origin:      string &default="builtin";
    };

    ## Generated by tools/osv-to-zeek.py into osv-package-cves.zeek.
    ## Same key format as package_cves but keyed by SOURCE package.
    const osv_package_cves: table[string] of vector of CVERec = {} &redef;

    ## "<distro>|<release>|<binary pkg>" -> source pkg, from OSV / distro
    ## package indexes (openssh-server -> openssh, libc6 -> glibc).
    const osv_binary_sources: table[string] of string = {} &redef;

    ## When the OSV table was generated ("" = never). Check this to make
    ## sure the cron job is actually running.
    const osv_generated_at: string = "" &redef;

    ## If OSV data exists for a (distro, release, package), ignore the
    ## hand-written package_cves rows for it (avoids duplicate alerts).
    option osv_overrides_builtin: bool = T;

    ## Emit ONE row per vulnerable download listing every unpatched CVE and
    ## the version that fixes them all, instead of one row per CVE / fix
    ## group. Strongly recommended with OSV data (an old kernel can match
    ## 100+ fix groups).
    option collapse_matches: bool = T;

    ## Cap on CVE ids written into one collapsed row.
    option max_cves_in_row: count = 50;

    ## Lookup key: <distro>|<distro_major>|<package>
    ## Value: vector of CVEs that affect that combo. A row is flagged when
    ## the observed package version compares LESS THAN cve$fixed_in.
    ##
    ## distro: one of "ubuntu", "debian", "rhel", "centos", "rocky",
    ##         "almalinux", "fedora", "oracle"
    ## distro_major: e.g. "8", "9", "20.04", "22.04", "11", "12"
    ## package: exact filename-derived package name
    ##
    ## Distro-aware CVE table for high-impact packages.
    ## Sources: Debian Security Tracker, Ubuntu USN, Red Hat errata, NVD.
    ## Redef in local.zeek to extend or override.
    const package_cves: table[string] of vector of CVERec = {
        # ---- xz-utils backdoor (CVE-2024-3094) -----------------------
        # Special case: only sid/Fedora-rawhide ever shipped these. Any
        # production host downloading xz 5.6.0 or 5.6.1 = hard flag.
        ["debian|sid|xz-utils"] = vector(
            CVERec($cve="CVE-2024-3094", $fixed_in="5.6.1+really5.4.5",
                   $severity="Critical",
                   $description="xz-utils backdoor (sshd auth bypass) - downgrade to 5.4.x")
        ),
        ["fedora|41|xz"] = vector(
            CVERec($cve="CVE-2024-3094", $fixed_in="5.4.6",
                   $severity="Critical",
                   $description="xz-utils backdoor (sshd auth bypass) - downgrade to 5.4.6")
        ),

        # ---- OpenSSH regreSSHion (CVE-2024-6387) ---------------------
        ["debian|11|openssh-server"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="1:8.4p1-5+deb11u6",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race"),
            CVERec($cve="CVE-2023-38408", $fixed_in="1:8.4p1-5+deb11u3",
                   $severity="Critical",
                   $description="ssh-agent PKCS#11 forwarding RCE")
        ),
        ["debian|12|openssh-server"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="1:9.2p1-2+deb12u9",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race"),
            CVERec($cve="CVE-2023-38408", $fixed_in="1:9.2p1-2+deb12u3",
                   $severity="Critical",
                   $description="ssh-agent PKCS#11 forwarding RCE")
        ),
        ["ubuntu|22.04|openssh-server"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="1:8.9p1-3ubuntu0.10",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),
        ["ubuntu|jammy|openssh-server"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="1:8.9p1-3ubuntu0.10",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),
        ["ubuntu|24.04|openssh-server"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="1:9.6p1-3ubuntu13.3",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),
        ["ubuntu|noble|openssh-server"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="1:9.6p1-3ubuntu13.3",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),
        ["rhel|9|openssh"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="8.7p1-38.el9_4.4",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),
        ["rocky|9|openssh"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="8.7p1-38.el9_4.4",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),
        ["almalinux|9|openssh"] = vector(
            CVERec($cve="CVE-2024-6387", $fixed_in="8.7p1-38.el9_4.4",
                   $severity="Critical",
                   $description="regreSSHion: unauthenticated RCE via signal handler race")
        ),

        # ---- PwnKit (CVE-2021-4034) ----------------------------------
        ["debian|10|policykit-1"] = vector(
